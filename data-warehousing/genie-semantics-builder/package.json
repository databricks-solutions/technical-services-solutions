{
  "name": "semantics-builder",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebuild": "pnpm run sync && appkit generate-types --wait",
    "predev": "pnpm run sync && pnpm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "e2e": "playwright test",
    "e2e:login": "playwright codegen --save-storage=tests/e2e/.auth/user.json \"$E2E_BASE_URL\""
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Design, validate, optimize and govern UC metric views with an LLM advisor",
  "dependencies": {
    "@databricks/appkit": "0.84.0",
    "@databricks/appkit-ui": "0.84.0",
    "@databricks/design-system": "2.0.16",
    "@databricks/sdk-experimental": "0.17.0",
    "@emotion/react": "11.14.0",
    "moment": "2.30.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.0",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "pg": "8.18.0",
    "prettier": "3.6.2",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.37.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7",
    "fast-uri": "3.1.0",
    "socks": "2.8.7",
    "bare-path": "3.1.1",
    "bare-url": "2.5.2"
  }
}
