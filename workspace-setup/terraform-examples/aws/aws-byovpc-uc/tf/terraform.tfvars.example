# =============================================================================
# Databricks Configuration
# =============================================================================

# Your Databricks account ID (found in Databricks Account Console)
databricks_account_id = "your-databricks-account-id"

# Prefix for Databricks resources (workspace name, storage config, etc.)
prefix = "my-databricks-workspace"

# Prefix for AWS resources (VPC, S3, IAM, etc.)
resource_prefix = "my-databricks-workspace"

# Pricing tier of account (ENTERPRISE or PREMIUM)
pricing_tier = "PREMIUM"

# Cross-account IAM access policy variant (see README "Cross-account IAM policy type"):
#   "customer"   - Customer-managed VPC with default restrictions (default)
#   "restricted" - Customer-managed VPC with custom restrictions: EC2 actions scoped to
#                  this AWS account (aws_account_id), region, VPC and a single security group
cross_account_policy_type = "customer"

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS region where resources will be deployed
region = "us-west-2"

# Optional: Additional tags for AWS resources
# tags = {
#   Environment = "production"
#   Team        = "data-engineering"
#   CostCenter  = "engineering"
# }

# =============================================================================
# Network Configuration
# =============================================================================

# Option 1: Create new VPC (leave vpc_id empty and specify network config)
vpc_id               = ""
nat_gateway_mode     = "single" # "single" or "per_az"
vpc_cidr_range       = "10.0.0.0/16"
availability_zones   = ["us-west-2a", "us-west-2b"]
private_subnets_cidr = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnets_cidr  = ["10.0.101.0/24", "10.0.102.0/24"]
# Option 2: Use existing VPC (uncomment and specify IDs)
# vpc_id     = "vpc-xxxxxxxxx"
# subnet_ids = ["subnet-xxxxxxxxx", "subnet-yyyyyyyyy"]

# Example: new /18 BYOVPC in ap-southeast-1, no PrivateLink, restricted cross-account policy.
# Set region = "ap-southeast-1" and cross_account_policy_type = "restricted" above, then:
# vpc_id               = ""
# nat_gateway_mode     = "single"
# vpc_cidr_range       = "10.10.0.0/18"
# availability_zones   = ["ap-southeast-1a", "ap-southeast-1b"]
# private_subnets_cidr = ["10.10.0.0/20", "10.10.16.0/20"]   # Databricks cluster subnets (/20 each)
# public_subnets_cidr  = ["10.10.32.0/26", "10.10.32.64/26"] # NAT gateway / IGW subnets
# security_group_ids   = []                                  # template creates one SG; the policy is scoped to it
#
# Same, but with an existing /18 VPC (restricted requires exactly one security group):
# vpc_id             = "vpc-xxxxxxxxx"
# subnet_ids         = ["subnet-xxxxxxxxx", "subnet-yyyyyyyyy"]
# security_group_ids = ["sg-xxxxxxxxx"]

# =============================================================================
# Security Group Configuration
# =============================================================================

# Use existing security groups (leave empty for dedicated security group to be created automatically)
security_group_ids = []

# Optional: Set custom security group name (defaults to '<resource_prefix>-databricks-sg' if left empty)
# new_security_group_name = "my-databricks-sg"

# Egress ports for Databricks connectivity
sg_egress_ports = [443, 3306, 2443, 5432, 8443, 8444, 8445, 8446, 8447, 8448, 8449, 8450, 8451]

# =============================================================================
# Unity Catalog Metastore Configuration
# =============================================================================

# Option 1: Create new metastore (leave metastore_id empty and specify name)
metastore_id   = ""
metastore_name = "my-unity-catalog-metastore"

# Option 2: Use existing metastore (uncomment and specify ID)
# metastore_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# =============================================================================
# Unity Catalog Storage Configuration
# =============================================================================

# AWS account ID where Unity Catalog IAM role and S3 bucket will be created.
# With cross_account_policy_type = "restricted" this must match the account of your AWS credentials.
aws_account_id = "your-aws-account-id"

# =============================================================================
# User-defined Catalog in UC (Optional)
# =============================================================================

# Set to true to create a user-defined catalog (storage credential, IAM role, S3 bucket, external location)
new_catalog = true

# Optional: override the generated names (only used when new_catalog = true)
# catalog_name              = "my_catalog"
# external_location_name    = "my-external-location"
# storage_credential_name   = "my-storage-credential"

# =============================================================================
# Cluster Configuration (Optional)
# =============================================================================

# Set to true to create a UC-compatible single-node cluster in the workspace
new_cluster = false

# Optional: override the cluster default (only used when new_cluster = true)
# cluster_autotermination_minutes = 10

# =============================================================================
# Workspace Admin / Catalog Access (Optional)
# =============================================================================

# Databricks account user to make workspace admin and grant ALL PRIVILEGES on the
# user-defined catalog, external location and storage credential. Without it, only the
# Terraform principal can see the catalog. Leave empty to skip.
workspace_admin_email = "you@company.com"