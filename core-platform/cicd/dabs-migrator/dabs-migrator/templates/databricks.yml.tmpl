# Bundle entrypoint. Keep this file thin — delegate resource definitions to resources/**/*.yml.
# Docs: https://docs.databricks.com/aws/en/dev-tools/bundles/settings

bundle:
  name: {{ project_name }}

include:
  - resources/**/*.yml

variables:
  # Environment values are set per target under targets.<target>.variables, never as a
  # top-level default and never from CI (BUNDLE_VAR_* overrides target values).
  # catalog and schema have no default on purpose: a target that forgets them fails
  # `databricks bundle validate` instead of silently deploying into the wrong place.
  catalog:
    description: Unity Catalog catalog for this target (set per target)

  schema:
    description: Unity Catalog schema for this target (set per target)

  # Declare the variables below only when a migrated resource uses them, and then set
  # them in every target. An unused variable without a value fails validate.
  # warehouse_id:
  #   description: SQL warehouse ID for this target (set per target)

  schedule_pause_status:
    description: PAUSED or UNPAUSED for schedules, triggers and alerts that are active in the source. dev is always PAUSED.
    default: PAUSED

  notification_emails:
    description: Failure and alert recipients for this target. dev never notifies production recipients.
    type: complex
    default: []

  # Every ${var.*} referenced below MUST be declared here or the target fails
  # `databricks bundle validate` with "reference does not exist: ${var.<name>}".
  workspace_host:
    description: Target workspace URL (overridden per target under targets.<t>.variables)
    default: https://<workspace-host>.cloud.databricks.com

  staging_sp_app_id:
    description: Service principal application ID used to deploy to staging (set via CI secret)
    default: <staging-service-principal-application-id>

  prod_sp_app_id:
    description: Service principal application ID used to deploy to prod (set via CI secret)
    default: <prod-service-principal-application-id>

targets:
  dev:
    mode: development
    default: true
    # No workspace.host: dev deploys to the workspace of the developer's auth profile.
    # No run_as: dev runs as the developer, never as a production identity.
    variables:
      catalog: <dev-catalog>                         # must differ from the prod catalog
      schema: dev_${workspace.current_user.short_name} # personal dev schema
      schedule_pause_status: PAUSED
      notification_emails: []

  staging:
    mode: production
    workspace:
      host: ${var.workspace_host}
      root_path: /Workspace/Shared/.bundle/${bundle.name}/${bundle.target}
    variables:
      workspace_host: https://<staging-workspace-host>.cloud.databricks.com
      catalog: <staging-catalog>
      schema: <staging-schema>
      schedule_pause_status: UNPAUSED
      notification_emails: []                       # e.g. [staging-alerts@example.com]
    run_as:
      service_principal_name: ${var.staging_sp_app_id}

  prod:
    mode: production
    workspace:
      host: ${var.workspace_host}
      root_path: /Workspace/Shared/.bundle/${bundle.name}/${bundle.target}
    variables:
      workspace_host: https://<prod-workspace-host>.cloud.databricks.com
      catalog: <prod-catalog>
      schema: <prod-schema>
      schedule_pause_status: UNPAUSED
      notification_emails: []                       # e.g. [prod-oncall@example.com]
    run_as:
      service_principal_name: ${var.prod_sp_app_id}
    permissions:
      - level: CAN_VIEW
        group_name: users
