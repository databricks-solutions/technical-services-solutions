    "instructions": {
      "text_instructions": [
        {
          "id": "04f25e2992d90b875d919d7e5905a0b8",
          "content": [
            "This space answers retail sales and revenue questions. Summarize the result first, then cite any filters that were applied. Prefer the curated revenue measure over ad-hoc aggregation, and disambiguate product versus category when the user is vague.\n"
          ]
        }
