#!/usr/bin/env bash
# One command: build the lineage from analyzer JSON and open the viewer.
#   ./sts-lb-lineage report.json [more.json ...] [-o DIR] [--focus NAME]
#   ./sts-lb-lineage --run ./src --platform "Informatica - PC" [-o DIR]
# Extra flags pass through to sts_lb_lineage.py. NO_OPEN=1 skips opening the browser.
# --rebuild-viewer rebuilds lineage_viewer.html from viewer/ (needs Node; maintainers only).
set -euo pipefail
caller=$PWD
here=$(cd "$(dirname "$0")" && pwd)

if ! command -v uv >/dev/null; then
  echo "uv is required. Install it, then rerun: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

rebuild=0
out=lineage
args=()
while (($#)); do
  case $1 in
    -o | --out) out=$2; shift 2 ;;
    --rebuild-viewer) rebuild=1; shift ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ ! -f $here/lineage_viewer.html ]] && ! ((rebuild)); then
  echo "lineage_viewer.html is missing. Restore it from git, or rebuild it with --rebuild-viewer (needs Node)." >&2
  exit 1
fi
if ((rebuild)); then
  command -v npm >/dev/null || { echo "npm is required to build the viewer" >&2; exit 1; }
  echo "Building the viewer..."
  log=$(mktemp)
  (cd "$here/viewer" && { [[ -d node_modules ]] || npm ci --legacy-peer-deps --no-audit --no-fund; } && npm run -s build) >"$log" 2>&1 \
    || { cat "$log" >&2; exit 1; }
fi
((${#args[@]})) || { sed -n 3,6p "$0" | sed 's/^# //'; exit 1; }

cd "$caller"
uv run --quiet "$here/sts_lb_lineage.py" "${args[@]}" -o "$out"

html=$out/lineage.html
if [[ -f $html && -z ${NO_OPEN:-} ]]; then
  if command -v open >/dev/null; then open "$html"; elif command -v xdg-open >/dev/null; then xdg-open "$html"; else echo "Open $html"; fi
fi
