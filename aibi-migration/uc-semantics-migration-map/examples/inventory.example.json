        "comp store",
        "same-store"
      ],
      "domain_hint": "Sales",
      "source": "docs/kpi-glossary.pdf"
    },
    {
      "term": "Active Customer",
      "definition": "A customer with at least one completed order in the trailing 90 days.",
      "synonyms": [
        "AC"
      ],
      "domain_hint": "Customer Orders",
      "source": "docs/kpi-glossary.pdf"
    }
