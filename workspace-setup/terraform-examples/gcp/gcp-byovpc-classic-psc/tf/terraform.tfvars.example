######################################################
# Authentication / Project
######################################################
google_service_account_email = "<sa>@<project>.iam.gserviceaccount.com"
google_project_name          = "<gcp-project-id>"
google_region                = "us-central1"

######################################################
# Network
######################################################
# New VPC (default): set subnet_cidr and leave vpc_name empty.
subnet_cidr     = "10.10.0.0/22" # Databricks node subnet (ignored when vpc_name is set)
psc_subnet_cidr = "10.10.4.0/28" # PSC endpoint subnet (must not overlap the node subnet)

# Existing VPC: set these and Terraform reuses the VPC/node subnet, still creating
# a dedicated PSC subnet in that VPC.
# vpc_network_project_id = "<vpc-host-project>"
# vpc_name               = "<existing-vpc-name>"
# subnet_name            = "<existing-node-subnet-name>"

# NAT gateway for outbound egress from the (no-public-IP) nodes.
#   true  = deploy Cloud Router + Cloud NAT (default; nodes reach the internet).
#   false = fully-private / NVA-routed; no general internet egress. Private Google
#           Access still covers Google APIs, but public pip/Maven installs and
#           public data sources will fail.
create_nat_gateway = true

######################################################
# Databricks Account / Workspace
######################################################
databricks_account_id     = "<account-id>"
databricks_workspace_name = "<workspace-name>"
databricks_admin_user     = "<admin-user-email>"

# Unity Catalog: leave metastore_id empty to create a new metastore.
# metastore_id   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
metastore_id   = ""
metastore_name = ""

######################################################
# Backend Private Service Connect
######################################################
# Region-specific service attachment URIs — see the region table in the README.
# The example values below are for us-central1.
workspace_service_attachment = "projects/gcp-prod-general/regions/us-central1/serviceAttachments/plproxy-psc-endpoint-all-ports"
relay_service_attachment     = "projects/prod-gcp-us-central1/regions/us-central1/serviceAttachments/ngrok-psc-endpoint"

# Optional endpoint names (defaults are fine for a single workspace)
# workspace_pe_name = "dbx-backend-rest-ep"
# relay_pe_name     = "dbx-backend-relay-ep"

# Backend-only PSC: front-end/user access remains over the public internet.
public_access_enabled = true

######################################################
# Private DNS (required so the compute plane resolves to the PSC endpoints)
######################################################
create_private_dns = true
private_zone_name  = "databricks-psc"
dns_name           = "gcp.databricks.com." # trailing dot is required
