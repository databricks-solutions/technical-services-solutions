  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Load Dim" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{cf8838af-705b-4797-8a85-ccfd58d8daa4}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="Load Dim">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{22222222-2222-2222-2222-222222222222}" SQLTask:SqlStatementSource="INSERT INTO dw.dim_customer SELECT s.customer_id, s.name FROM stg.customer_clean s INNER JOIN raw.customer_status t ON t.customer_id = s.customer_id WHERE t.active = 1"/>
