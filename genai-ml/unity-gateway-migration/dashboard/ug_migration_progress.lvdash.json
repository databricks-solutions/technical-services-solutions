{
 "datasets": [
  {
   "name": "ds_trend",
   "displayName": "Progress over time",
   "queryLines": [
    "SELECT snapshot_time, ",
    "sum(legacy_requests) AS legacy_requests, sum(v3_requests) AS v3_requests, ",
    "sum(active_legacy_endpoints) AS active_legacy_endpoints, ",
    "count_if(wave LIKE '0%') AS enforce_candidates, count(*) AS workspaces ",
    "FROM ug_migration_workspaces GROUP BY snapshot_time ORDER BY snapshot_time"
   ]
  },
  {
   "name": "ds_kpi",
   "displayName": "Latest snapshot",
   "queryLines": [
    "SELECT max(snapshot_time) AS snapshot_time, ",
    "sum(legacy_requests) AS legacy_requests, sum(v3_requests) AS v3_requests, ",
    "try_divide(sum(v3_requests), sum(v3_requests) + sum(legacy_requests)) AS v3_share, ",
    "sum(active_legacy_endpoints) AS active_legacy_endpoints, ",
    "count_if(wave LIKE '0%') AS enforce_candidates, count(*) AS workspaces ",
    "FROM ug_migration_workspaces WHERE snapshot_time = (SELECT max(snapshot_time) FROM ug_migration_workspaces)"
   ]
  },
  {
   "name": "ds_waves",
   "displayName": "Workspaces by wave",
   "queryLines": [
    "SELECT wave, CASE WHEN wave LIKE 'v2%' THEN 0 WHEN wave LIKE '0%' THEN 1 WHEN wave LIKE '1: cleanup%' THEN 2 WHEN wave LIKE '1%' THEN 3 ELSE 4 END AS wave_order, count(*) AS workspaces, sum(legacy_requests) AS legacy_requests ",
    "FROM ug_migration_workspaces WHERE snapshot_time = (SELECT max(snapshot_time) FROM ug_migration_workspaces) GROUP BY wave ORDER BY wave_order"
   ]
  },
  {
   "name": "ds_workspaces",
   "displayName": "Workspaces (latest)",
   "queryLines": [
    "SELECT workspace_name, workspace_id, wave, legacy_endpoints, custom_legacy_endpoints, ",
    "active_legacy_endpoints, v1_requests, legacy_requests, legacy_throttled, v2_requests, v3_requests, v3_share ",
    "FROM ug_migration_workspaces WHERE snapshot_time = (SELECT max(snapshot_time) FROM ug_migration_workspaces) ",
    "ORDER BY legacy_requests DESC, custom_legacy_endpoints DESC"
   ]
  },
  {
   "name": "ds_endpoints",
   "displayName": "Busiest legacy endpoints (latest)",
   "queryLines": [
    "SELECT workspace_name, endpoint_name, kind, requests, requesters, throttled, last_request ",
    "FROM ug_migration_endpoints WHERE snapshot_time = (SELECT max(snapshot_time) FROM ug_migration_endpoints) AND requests > 0 AND kind <> 'out_of_scope' ",
    "ORDER BY requests DESC LIMIT 200"
   ]
  }
 ],
