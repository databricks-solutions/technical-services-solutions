# =============================================================================
# Azure Configuration
# =============================================================================

tenant_id             = "xxx"
azure_subscription_id = "xxx"
tags = {
  "Owner" : "Name Of Owner"
}

# =============================================================================
# Databricks Workspace Configuration
# =============================================================================

resource_group_name         = "new-resource-group"
workspace_name              = "databricks-workspace"
admin_user                  = "xx@xx.com"
root_storage_name           = "databricksrootstorage"
location                    = "westeurope"
databricks_account_id       = "xxx-xxx"
managed_resource_group_name = null # optional. If no name is provided, Azure generates one automatically.

# Metastore: attach an existing one OR create a new one (exactly one path).
#   - Attach existing (recommended): set existing_metastore_id, leave new_metastore_name = "".
#   - Create new:                    leave existing_metastore_id = "", set new_metastore_name.
# Azure allows only ONE Unity Catalog metastore per region per account, so in most
# accounts the regional metastore already exists — attach it rather than creating one
# (creating fails if the region already has a metastore). Find IDs with:
#   databricks account metastores list
existing_metastore_id = "REPLACE-WITH-EXISTING-METASTORE-UUID"
new_metastore_name    = ""

# =============================================================================
# Unity Catalog (user-defined catalog) Configuration
# =============================================================================

uc_storage_account_name = "ucrootstorage" # globally unique, 3-24 chars, lowercase alphanumeric
catalog_name            = "my-catalog"
storage_credential_name = "my-uc-storage-cred"
external_location_name  = "my-ext-loc"

# Optional UC storage security hardening (defaults keep the account reachable for
# the initial deploy). For production, restrict network access:
# uc_storage_network_default_action        = "Deny"
# uc_storage_allowed_ip_rules              = ["<your-deployer-public-ip>"]
# uc_storage_allowed_subnet_ids            = [] # workspace subnet IDs (need Microsoft.Storage service endpoint)
# uc_storage_public_network_access_enabled = true

# =============================================================================
# Cluster Configuration (optional)
# =============================================================================
create_cluster                  = false
node_type_id                    = "Standard_DS3_v2"
cluster_autotermination_minutes = 10

# =============================================================================
# Network Configuration
# =============================================================================

# Create a new VNet (create_new_vnet = true): vnet_name is ignored; the VNet is
# named "<workspace_name>-vnet" and created in vnet_resource_group_name.
# Reuse an existing VNet (create_new_vnet = false): set vnet_name to the existing
# VNet and vnet_resource_group_name to its resource group.
create_new_vnet          = true
vnet_name                = "" # required only when create_new_vnet = false
vnet_resource_group_name = "vnet-resource-group-name"

# NAT gateway availability zone (["1"], ["2"], or ["3"]); use [] for non-zonal regions.
nat_gateway_zones = ["1"]

cidr                = "10.0.0.0/20" # matches the variable default; subnets below must fit inside it
subnet_public_cidr  = "10.0.1.0/24"
subnet_private_cidr = "10.0.2.0/24"
