# Copy to .env or export in your shell. Do not commit secrets.

SNOWFLAKE_ACCOUNT=acmeorg-prod1
SNOWFLAKE_USER=extract_svc
SNOWFLAKE_ROLE=METADATA_READER
SNOWFLAKE_WAREHOUSE=WH_EXTRACT

# Password auth (default). Leave unset if using SSO.
SNOWFLAKE_PASSWORD=

# Use SSO in the customer browser instead of a password:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional: comma-separated database allowlist. Empty = all non-system databases.
# SNOWFLAKE_DATABASES=SALES_MART,RISK_HUB
