      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{22222222-2222-2222-2222-222222222222}" SQLTask:SqlStatementSource="INSERT INTO stg.customer_clean (customer_id, name, region_id) SELECT c.customer_id, c.name, r.region_id FROM raw.customer c INNER JOIN raw.region r ON c.region_id = r.region_id"/>
