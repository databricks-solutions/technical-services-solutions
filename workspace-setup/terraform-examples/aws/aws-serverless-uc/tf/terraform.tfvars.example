# =============================================================================
# Required Configuration
# =============================================================================

databricks_account_id = "00000000-0000-0000-0000-000000000000"
aws_account_id        = "123456789012"
region                = "ap-northeast-1"

# =============================================================================
# Resource Naming
# =============================================================================

prefix          = "demo-serverless"
resource_prefix = "demo-serverless"

# =============================================================================
# Unity Catalog Metastore
# =============================================================================

# Create a new metastore.
metastore_name = "demo-serverless-metastore"

# To attach an existing metastore instead, set its ID and leave
# metastore_name empty.
# metastore_id   = "00000000-0000-0000-0000-000000000000"
# metastore_name = ""

# =============================================================================
# User Defined Catalog
# =============================================================================

new_catalog = true

# Optional name overrides. Empty values use prefix-based defaults.
# catalog_name            = "demo_catalog"
# external_location_name  = "demo-external-location"
# storage_credential_name = "demo-storage-credential"
